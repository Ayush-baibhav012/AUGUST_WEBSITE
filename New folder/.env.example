PORT=3012

# Set true only while debugging — shows real error text in the browser (remove for production)
SHOW_SERVER_ERRORS=false

# Required to protect admin endpoints such as GET /api/contact
ADMIN_TOKEN=change-this-to-a-long-random-string

# Optional: enable MongoDB (if empty, JSON file storage is used)
MONGODB_URI=

# Optional: enable email notifications when contact form is submitted
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@example.com
NOTIFY_TO_EMAIL=your-email@example.com
